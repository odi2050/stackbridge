# Docker utilise toujours l'image la plus récente par défaut.
# Remplacez "latest" par une version précise uniquement pour figer volontairement le déploiement.
APP_VERSION=latest

# Générez le hash avec :
# python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('VOTRE_MOT_DE_PASSE'))"
ADMIN_PASSWORD_HASH=scrypt:32768:8:1$REMPLACEZ_MOI

# Générez une clé avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACEZ_MOI

# Facultatif mais recommandé en production. Générez avec :
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sans cette variable, une clé locale persistante est créée dans data/.settings.key.
SETTINGS_ENCRYPTION_KEY=

# Mettre true uniquement lorsque l'application est servie en HTTPS.
SESSION_COOKIE_SECURE=false
